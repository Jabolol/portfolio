{
  "lock": false,
  "tasks": {
    "start": "deno run -A --unstable-kv --unstable-cron --env --watch=static/,routes/ dev.ts",
    "build": "deno run -A --unstable-kv --unstable-cron --env dev.ts build",
    "preview": "deno run -A --unstable-kv --unstable-cron --env main.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["deno.window", "dom", "deno.unstable"]
  },
  "imports": {
    "$fresh/": "https://raw.githubusercontent.com/Jabolol/fresh/remote-addr/",
    "preact": "https://esm.sh/*preact@10.15.1",
    "preact/": "https://esm.sh/*preact@10.15.1/",
    "preact-render-to-string": "https://esm.sh/*preact-render-to-string@6.2.1?deps=preact@10.15.1",
    "@preact/signals": "https://esm.sh/*@preact/signals@1.1.3",
    "@preact/signals-core": "https://esm.sh/*@preact/signals-core@1.2.3",
    "twind": "https://esm.sh/twind@0.16.19",
    "twind/": "https://esm.sh/twind@0.16.19/",
    "$icons/": "https://deno.land/x/tabler_icons_tsx@0.0.3/tsx/",
    "ga4/": "https://deno.land/x/fresh_ga4@0.0.2/",
    "activity-calendar": "https://esm.sh/react-activity-calendar@2.0.2?alias=react:preact/compat,@types/react:preact/compat&deps=preact@10.15.1&external=preact",
    "resvg-wasm": "https://esm.sh/@resvg/resvg-wasm@2.6.2",
    "$std/": "https://deno.land/std@0.202.0/",
    "~/": "./"
  },
  "lint": {
    "rules": {
      "tags": ["fresh", "recommended"]
    },
    "exclude": ["_fresh"]
  },
  "fmt": {
    "exclude": ["_fresh"]
  },
  "deploy": {
    "project": "1c335ba4-0a27-42a9-bb88-9df460aa05d3",
    "exclude": ["**/node_modules"],
    "include": [],
    "entrypoint": "main.ts"
  }
}
